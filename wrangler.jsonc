// Cloudflare Workers Builds: every merge to main runs
//   node scripts/cf-static-assets.mjs --copy --out dist
// (only the public site files go into dist/, plus _headers/_redirects copied from cloudflare/)
// and then `npx wrangler deploy`. Static files only: no main and no routes
// (sere.dimau-fintech.com is attached in Cloudflare).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sere",
  "compatibility_date": "2026-11-01",
  // Ops Room live check: writes dist/ops-build.json after the site build.\n  "build": { "command": "node scripts/ops-build-marker.mjs dist donovandimau/Sere-Fijian-Lyrics" },
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash"
  }
}
